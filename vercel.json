{
  "buildCommand": "ng build --configuration production",
  "outputDirectory": "dist/browser",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/*.md"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
